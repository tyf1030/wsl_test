        <UserObject label="loss_func_from_item(x) → get_loss_func(...) 返回闭包 func(x):&#xa;├ refine_cam2cc(cam2cc, x):&#xa;│ Rotation.from_euler zyx 取 x 前 3 维（度）&#xa;│ new_R = rmat @ R, new_t = t + rmat @ t&#xa;├ cam2world = cc2world @ new_cam2cc&#xa;├ world2cam = inv(cam2world)&#xa;├ point_to_image_loss():&#xa;│ PerspectiveCamTransform.compute_krt_proj 投影到图像&#xa;│ WeightedPointToImageLoss（深度范围见 CAMERA_DIST_MAP）&#xa;└ 正则项 + ‖x‖" mermaidId="n:E3" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="loss_func_from_item(x) → get_loss_func(...) 返回闭包 func(x):&#xa;├ refine_cam2cc(cam2cc, x):&#xa;│ Rotation.from_euler zyx 取 x 前 3 维（度）&#xa;│ new_R = rmat @ R, new_t = t + rmat @ t&#xa;├ cam2world = cc2world @ new_cam2cc&#xa;├ world2cam = inv(cam2world)&#xa;├ point_to_image_loss():&#xa;│ PerspectiveCamTransform.compute_krt_proj 投影到图像&#xa;│ WeightedPointToImageLoss（深度范围见 CAMERA_DIST_MAP）&#xa;└ 正则项 + ‖x‖" id="lFHXUrIWJKKJLnCNufJF-72">
