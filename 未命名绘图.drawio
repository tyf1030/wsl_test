  <diagram id="_lyFPx5hR4E8pvnvK5xq" name="第 8 页">
    <mxGraphModel dx="1266" dy="660" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    subgraph ENTRY[\&quot;入口：run_on_hdmap.py::main()\&quot;]\n        A[\&quot;click 参数: --parse / --vma-annos / --lidar-type&lt;br/&gt;--cache / --conf-path / --fps / --skip-mask2former / --skip-mask4d\&quot;]\n        A --&gt; B[\&quot;组装 config 路径:&lt;br/&gt;align_file  = parse/sensor_temporal_alignment.json&lt;br/&gt;pose_file   = parse/cloud_reconstruction/pose.txt&lt;br/&gt;calib_path  = parse/calib/&lt;br/&gt;local_hdmap = parse/local_hdmap.json&lt;br/&gt;bev_params_file = parse/slam_output/geometry_generation_results/image_meta.txt&lt;br/&gt;ground_pcd  = parse/cloud_reconstruction/ground.pcd&lt;br/&gt;pcd_file    = cache/mask4d.pcd&lt;br/&gt;sparse_output_pcd = cache/mask4d_sparse.pcd&lt;br/&gt;output_file = cache/mask4d_sparse_to_frames.json&lt;br/&gt;sensor_map_file = cache/sensor_map.json&lt;br/&gt;config_file = cache/config.json&lt;br/&gt;dataset_file = cache/dataset.txt&lt;br/&gt;mask_path   = cache/mask2former/&lt;br/&gt;calib_cloud_path = cache/calib_cloud/&lt;br/&gt;image_pose  = cache/image_pose.txt&lt;br/&gt;bounds = [±0.5° yaw/pitch/roll, ±1e-3m tx/ty/tz]&lt;br/&gt;pcd_query_radius=200.0, max_threads=min(8,cpu)\&quot;]\n    end\n\n    subgraph STEP1[\&quot;Step1：语义标注 → 3D 点云（ThreadPoolExecutor 2 线程并行，--skip-mask4d 时跳过）\&quot;]\n        B --&gt; C{\&quot;skip_mask4d?\&quot;}\n        C -- \&quot;否\&quot; --&gt; D1[\&quot;线程A: AnnoToPCD.init(config) → process()\&quot;]\n        C -- \&quot;否\&quot; --&gt; D2[\&quot;线程B: SparseAnnoToPCD.init(config) → process()\&quot;]\n        D1 --&gt; E1[\&quot;load_bev_params(image_meta.txt)&lt;br/&gt;读 BEV 图参数 min_x/min_y/H/分辨率&lt;br/&gt;构造 world2image → np.linalg.inv → image2world\&quot;]\n        E1 --&gt; F1[\&quot;load_vma_anno(vma_annos={local_parser}/vma_cache/{parser}.json)&lt;br/&gt;解析 json[&#39;step_1&#39;][&#39;result&#39;]&lt;br/&gt;过滤 attribute ∈ {LANELINE:24, CROSSWALK:23, ARROW:24, ROADMARKER:24}\&quot;]\n        F1 --&gt; G1[\&quot;process_lines / process_boxes:&lt;br/&gt;像素点 × image2world → 世界系&lt;br/&gt;CROSSWALK → sample_rectangle(step=5.0)&lt;br/&gt;线 → linestrip_to_dense(step=5.0)\&quot;]\n        G1 --&gt; H1[\&quot;recover_height(cvt_annos_map, ground_pcd):&lt;br/&gt;load_pcd(parse/cloud_reconstruction/ground.pcd)&lt;br/&gt;KDTree(points[:,:2])&lt;br/&gt;lane3ds_z_from_direct_plane() 恢复z高度&lt;br/&gt;├ get_mean_z_from_points()&lt;br/&gt;└ side_fitting_plane()&lt;br/&gt;rectify_crosswalk_z / rectify_roadmarker_z\&quot;]\n        H1 --&gt; I1[\&quot;加密:&lt;br/&gt;densify_lines → linestrip_to_dense(step=0.0375, pad=0.075)&lt;br/&gt;densify_crosswalks → fill_rectangle(step=0.05)&lt;br/&gt;densify_roadmarkers → fill_rectangle(step=0.05)\&quot;]\n        I1 --&gt; J1[\&quot;save_annos_to_pcd → save_pcd_xyzl&lt;br/&gt;★输出: cache/mask4d.pcd (xyz+label 稠密)\&quot;]\n        D2 --&gt; E2[\&quot;同 AnnoToPCD 流程&lt;br/&gt;但 dense_params 更稀疏(step=0.05, 无 pad)&lt;br/&gt;crosswalk/roadmarker 用 linestrip_to_dense 而非 fill_rectangle\&quot;]\n        E2 --&gt; J2[\&quot;save_annos_to_pcd → save_pcd_xyzl&lt;br/&gt;★输出: cache/mask4d_sparse.pcd (xyz+label 稀疏)\&quot;]\n        C -- \&quot;是\&quot; --&gt; K\n        J1 --&gt; K\n        J2 --&gt; K\n    end\n\n    subgraph STEP2[\&quot;Step2：ConcatCloudToFrames —— 点云切帧并排序\&quot;]\n        K[\&quot;ConcatCloudToFrames.init:&lt;br/&gt;read_calib(parse/calib/, camera)×3&lt;br/&gt;(center_camera_fov120 / fov30 / rear_camera)&lt;br/&gt;读 {cam}-intrinsic.json + {cam}-to-car_center-extrinsic.json\&quot;] --&gt; L[\&quot;process():&lt;br/&gt;load_pcd(cache/mask4d_sparse.pcd)&lt;br/&gt;load_pose(parse/cloud_reconstruction/pose.txt)&lt;br/&gt;→ load_pose_by_txt / load_pose_by_json\&quot;]\n        L --&gt; M2[\&quot;scipy KDTree.query_ball_point&lt;br/&gt;(每个位姿位置, r=200m) → 每帧候选点索引\&quot;]\n        M2 --&gt; N2[\&quot;ProcessPoolExecutor(min(8,cpu)):&lt;br/&gt;_process_one_frame(每帧):&lt;br/&gt;世界点 → 车体系(R_car_enu, t_car_enu)&lt;br/&gt;范围裁剪(|x|&lt;200, |y|&lt;50)&lt;br/&gt;→ 相机系(cam2cc 外参)&lt;br/&gt;按 camera_dist_map 深度范围统计可见点数\&quot;]\n        N2 --&gt; O2[\&quot;按 total_points_num 降序排序&lt;br/&gt;json.dump&lt;br/&gt;★输出: cache/mask4d_sparse_to_frames.json&lt;br/&gt;[frame_id, timestamp, total_points_num, camera_points_num]&lt;br/&gt;同时写入 config[&#39;mask4d_sparse_to_frames&#39;]\&quot;]\n    end\n\n    subgraph STEP3[\&quot;Step3：ClipToDataset —— 生成图像数据集\&quot;]\n        O2 --&gt; P[\&quot;read_extend_sensor_map():&lt;br/&gt;read_pose_map(pose_file=parse/cloud_reconstruction/pose.txt)&lt;br/&gt;read_sensor_map(align_file=parse/sensor_temporal_alignment.json, lidar_type)\&quot;]\n        P --&gt; Q[\&quot;merge_sensor_map_and_pose_map(sensor_map, pose_map, lidar_type)&lt;br/&gt;位姿写入每帧 cc2world\&quot;]\n        Q --&gt; R2[\&quot;sensor_map_down_sample_with_mask4d(sensor_map, mask4d_sparse_to_frames, fps):&lt;br/&gt;丢掉点数最少 20% 的帧, 再按 fps/(1-0.2) 时间间隔抽帧&lt;br/&gt;（无 mask4d 时退化为 sensor_map_down_sample(fps)）\&quot;]\n        R2 --&gt; S2[\&quot;sensor_map_to_dataset():&lt;br/&gt;sensor_map_to_custom_dataset(sensor_map, parse/calib/):&lt;br/&gt;每帧×每相机 → read_calib()&lt;br/&gt;item = {camera_name, image_file, cc2world,&lt;br/&gt;camK, camD, cam2cc, camera_model}&lt;br/&gt;补充 image_name / mask_png / pcd_file 字段\&quot;]\n        S2 --&gt; T2[\&quot;save(): write_json / write_jsonl&lt;br/&gt;★输出: cache/sensor_map.json&lt;br/&gt;★输出: cache/config.json&lt;br/&gt;★输出: cache/dataset.txt (jsonl, 每行一张图)\&quot;]\n    end\n\n    subgraph STEP4[\&quot;Step4：ImageRunUndistort —— 图像去畸变\&quot;]\n        T2 --&gt; U2[\&quot;process(): read_jsonl(cache/dataset.txt)&lt;br/&gt;ThreadPoolExecutor.map(undistort, X)\&quot;]\n        U2 --&gt; V2{\&quot;camera_model?\&quot;}\n        V2 -- \&quot;PERSPECTIVE\&quot; --&gt; W2[\&quot;undistort_perspective:&lt;br/&gt;shutil.copy2 原图 → cache/undistort/{image_name}\&quot;]\n        V2 -- \&quot;OPENCV_FISHEYE\&quot; --&gt; X2[\&quot;undistort_fisheye (focal×0.75):&lt;br/&gt;camD shape==(2,11) → undistort_scaramuzza()&lt;br/&gt;否则 → cv2.fisheye.undistortImage()&lt;br/&gt;cv2.imwrite → cache/undistort/{image_name}&lt;br/&gt;camD 清零, camera_model→&#39;PERSPECTIVE&#39;\&quot;]\n        W2 --&gt; Y2[\&quot;write_jsonl: 备份原始 dataset&lt;br/&gt;★输出: cache/dataset.txt.undistort.bak&lt;br/&gt;覆写: cache/dataset.txt (指向 undistort 图)\&quot;]\n        X2 --&gt; Y2\n    end\n\n    subgraph STEP5[\&quot;Step5：ImageRunMask2Former —— 语义分割（--skip-mask2former 时跳过）\&quot;]\n        Y2 --&gt; Z2{\&quot;skip_mask2former?\&quot;}\n        Z2 -- \&quot;否\&quot; --&gt; A3[\&quot;process(): 读 cache/dataset.txt&lt;br/&gt;inputs = [{image_file, save_path=cache/mask2former/{img}.png}]\&quot;]\n        A3 --&gt; B3[\&quot;mask2former/actor.py::image_run_mask2former&lt;br/&gt;(inputs, conf_path=docker/configs/petreloss.conf,&lt;br/&gt;hf_model=/root/.cache/huggingface/hub/models--facebook--&lt;br/&gt;mask2former-swin-large-mapillary-vistas-semantic/snapshots/4772b6bf...)&lt;br/&gt;★输出: cache/mask2former/*.png (语义分割图)\&quot;]\n        Z2 -- \&quot;是\&quot; --&gt; C3\n        B3 --&gt; C3\n    end\n\n    subgraph STEP6[\&quot;Step6：ImageRunPoseAdjustment —— 单图外参优化（Ray 多GPU）\&quot;]\n        C3[\&quot;process(): 读 cache/dataset.txt&lt;br/&gt;ray.data.from_items(dataset).map(Actor,&lt;br/&gt;num_gpus=0.5, concurrency=GPU数×2,&lt;br/&gt;fn_constructor_kwargs={bounds})\&quot;]\n        C3 --&gt; D3[\&quot;Actor.__call__(item):&lt;br/&gt;read_point_cloud → read_point_cloud_to_torch&lt;br/&gt;(open3d 读 cache/mask4d.pcd → verts+label_points → cuda, lru_cache×4)&lt;br/&gt;read_mask_png → read_mask_png_to_torch&lt;br/&gt;(PIL 读 cache/mask2former/*.png → semantic_map → cuda)\&quot;]\n        D3 --&gt; E3[\&quot;loss_func_from_item(x) → get_loss_func(...)&lt;br/&gt;返回闭包 func(x6dof):&lt;br/&gt;├ refine_cam2cc(cam2cc, x):&lt;br/&gt;│  Rotation.from_euler(&#39;zyx&#39;, x[0:3], deg)&lt;br/&gt;│  new_R = rmat@R, new_t = t + rmat@t&lt;br/&gt;├ cam2world = cc2world @ new_cam2cc&lt;br/&gt;├ world2cam = inv(cam2world)&lt;br/&gt;├ point_to_image_loss():&lt;br/&gt;│  PerspectiveCamTransform.compute_krt_proj&lt;br/&gt;│  (verts,camK,world2cam) → 投影到图像&lt;br/&gt;│  WeightedPointToImageLoss(cam_z 范围见&lt;br/&gt;│  CAMERA_DIST_MAP) 语义一致性 loss&lt;br/&gt;└ 正则项 +‖x‖\&quot;]\n        E3 --&gt; F3[\&quot;scipy.optimize.minimize(func, x0=zeros(6),&lt;br/&gt;method=&#39;L-BFGS-B&#39;, bounds=config.bounds,&lt;br/&gt;maxiter=500, ftol/gtol=1e-8)\&quot;]\n        F3 --&gt; G3{\&quot;opt.success 且&lt;br/&gt;score_optimized ≥ score_init?\&quot;}\n        G3 -- \&quot;是\&quot; --&gt; H3[\&quot;new_cam2cc = refine_cam2cc(cam2cc, opt.x)\&quot;]\n        G3 -- \&quot;否\&quot; --&gt; H3b[\&quot;new_cam2cc = 原 cam2cc (放弃优化)\&quot;]\n        H3 --&gt; I3[\&quot;item 附加: new_cam2cc / opt_x /&lt;br/&gt;image_pose_score_inited / image_pose_score_optimized\&quot;]\n        H3b --&gt; I3\n        I3 --&gt; J3[\&quot;write_jsonl&lt;br/&gt;★输出: cache/image_pose.txt (jsonl, 每图一行优化结果)\&quot;]\n    end\n\n    subgraph STEP7[\&quot;Step7：ImagePoseToAverage —— 每相机外参求平均\&quot;]\n        J3 --&gt; K3[\&quot;process():&lt;br/&gt;shutil.copytree(parse/calib/ → cache/calib_cloud/)&lt;br/&gt;read_jsonl(cache/image_pose.txt)&lt;br/&gt;groupby(camera_name)\&quot;]\n        K3 --&gt; L3[\&quot;compute_cam2cc_avg_on_dataset(g, q=camera_q_map[cam]):&lt;br/&gt;fov120: q=50(top)或10(front), fov30/rear:10, 其余:30&lt;br/&gt;score_threshold = np.percentile(score_optimized, q)&lt;br/&gt;只保留高分帧 (active)\&quot;]\n        L3 --&gt; M3[\&quot;pose_to_avg(cam2cc_active):&lt;br/&gt;Rotation.from_matrix(...).mean() 平均旋转&lt;br/&gt;tvec_array.mean() 平均平移 → cam2cc_avg&lt;br/&gt;统计 opt_x_mean / opt_x_std / score 均值\&quot;]\n        M3 --&gt; N3[\&quot;update_extrinsic(cache/calib_cloud/, camera_name, extra_info):&lt;br/&gt;备份原外参到 extra_info[&#39;cam2cc&#39;]&lt;br/&gt;★写: cache/calib_cloud/{cam}/{cam}-to-car_center-extrinsic.json&lt;br/&gt;sensor_calib.data = cam2cc_avg, 附带 extra_info\&quot;]\n    end\n\n    subgraph STEP8[\&quot;Step8：BundleRunPoseAdjustment —— 全局光束法平差（Ray 多GPU）★最终输出\&quot;]\n        N3 --&gt; O3[\&quot;init(): 创建 ray.remote(num_gpus=0.5)(Actor)&lt;br/&gt;× (GPU数×2) actor_list&lt;br/&gt;max_angle_diff=0.2°\&quot;]\n        O3 --&gt; P3[\&quot;process(): 读 cache/image_pose.txt&lt;br/&gt;load_extra_info_map_from_calib_path&lt;br/&gt;(cache/calib_cloud/, camera_list)&lt;br/&gt;取回上一步 extra_info(cam2cc 原值/cam2cc_avg/score_threshold)\&quot;]\n        P3 --&gt; Q3[\&quot;每相机: filter_data_by_score&lt;br/&gt;(image_pose_score_optimized &gt; score_threshold)\&quot;]\n        Q3 --&gt; R3[\&quot;bundle_pose_adjustment(data, cam2cc, cam2cc_avg):&lt;br/&gt;x0 = resume 平均外参相对原外参的 6DoF&lt;br/&gt;(Rotation.from_matrix(rmat).as_euler(&#39;zyx&#39;, deg))\&quot;]\n        R3 --&gt; S3[\&quot;定义 func(x): 该相机所有高分图&lt;br/&gt;cycle(actor_list) 轮询分发:&lt;br/&gt;actor.forward.remote(item+params=x)&lt;br/&gt;→ get_loss_func → loss_func_from_item&lt;br/&gt;(同 Step6 的投影语义 loss, Actor 内按&lt;br/&gt;image_file 缓存 loss_func)&lt;br/&gt;返回 mean(loss)\&quot;]\n        S3 --&gt; T3[\&quot;scipy.optimize.minimize(func, x0,&lt;br/&gt;method=&#39;L-BFGS-B&#39;, bounds=bounds,&lt;br/&gt;maxiter=500, disp=True)\&quot;]\n        T3 --&gt; U3{\&quot;opt.success 且 score 提升&lt;br/&gt;且 |Δ角度| 全 &lt; 0.2°?\&quot;}\n        U3 -- \&quot;是\&quot; --&gt; V3[\&quot;cam2cc_refine = refine_cam2cc(cam2cc, opt.x)\&quot;]\n        U3 -- \&quot;否\&quot; --&gt; V3b[\&quot;cam2cc_refine = cam2cc_avg (回退)\&quot;]\n        V3 --&gt; W3[\&quot;update_extrinsic(): write_json&lt;br/&gt;★最终输出: cache/calib_cloud/{cam}/&lt;br/&gt;{cam}-to-car_center-extrinsic.json&lt;br/&gt;sensor_calib.data = cam2cc_refine&lt;br/&gt;extra_info 追加 bundle_score_init/optimized 等\&quot;]\n        V3b --&gt; W3\n    end\n\n    W3 --&gt; FIN[\&quot;run_on_hdmap.main 结束&lt;br/&gt;← 返回 run_calib.py&lt;br/&gt;logger: &#39;---------- Calib step finished! ----------&#39;\&quot;]\n\n    style STEP8 fill:#ffe6cc\n    style W3 fill:#ffd9b3\n    style FIN fill:#d4edda\n    style J1 fill:#e8f4ff\n    style J2 fill:#e8f4ff\n    style O2 fill:#e8f4ff\n    style T2 fill:#e8f4ff\n    style B3 fill:#e8f4ff\n    style J3 fill:#e8f4ff\n    style N3 fill:#e8f4ff&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="I5nhy6NG0W2M_9OHj2Jm-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="2024" width="1391" as="geometry" />
          </mxCell>
        </UserObject>
