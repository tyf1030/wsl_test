        <UserObject label="线程B: SparseAnnoToPCD.init(config) → process()" mermaidId="n:D2" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="线程B: SparseAnnoToPCD.init(config) → process()" id="I5nhy6NG0W2M_9OHj2Jm-9">
