  <diagram id="36s6GaZCRb_RAs0HKvRt" name="Bev强度图2">
    <mxGraphModel dx="3652" dy="1848" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    START([开始]) --&gt; MAIN[main 函数入口]\n    MAIN --&gt; INIT_CONFIG[Configure::GetInstance()-&gt;Init&lt;br/&gt;读取 generate_rgb_color_config.yaml]\n    INIT_CONFIG --&gt; CALL_GAR[调用 GenerateAnnotationResults]\n\n    subgraph GenerateAnnotationResults [GenerateAnnotationResults 主控流程]\n        direction TB\n        GAR_START[开始] --&gt; LOAD_EXT[LoadSensorExtrinsics&lt;br/&gt;加载激光雷达/相机外参]\n        LOAD_EXT --&gt; LOAD_CAM[LoadCameraModels&lt;br/&gt;加载相机内参模型]\n        LOAD_CAM --&gt; LOAD_POSE[LoadHDPoses&lt;br/&gt;加载所有帧位姿]\n\n        LOAD_POSE --&gt; GEN_HEIGHT[GenerateHeightMap&lt;br/&gt;生成 height_cloud]\n        LOAD_POSE --&gt; GROUND_EXT[GroundExtraction::Process&lt;br/&gt;生成 occupy_map]\n\n        subgraph HeightMapLine [height_cloud 支线: 2D网格定边界]\n            direction TB\n            HM1[读取PCD目录] --&gt; HM2[逐帧点云转世界坐标系] --&gt; HM3[全局降采样 0.10m]\n            HM3 --&gt; HM4[确定地图边界&lt;br/&gt;min_x/max_x/min_y/max_y] --&gt; HM5[投影到2D网格求平均]\n            HM5 --&gt; HM6[输出 height_cloud&lt;br/&gt;每个格子一个平均点]\n        end\n\n        subgraph GroundExtLine [occupy_map 支线: 3D体素提取地面]\n            direction TB\n            GE1[读取原始PCD] --&gt; GE2[滑动窗口切分Submap] --&gt; GE3[LPR地面提取算法]\n            GE3 --&gt; GE4[UpdateOccupyMapByHitVoxel&lt;br/&gt;更新3D体素统计]\n            GE4 --&gt; GE5[MapRefine 后处理]\n            GE5 --&gt; GE6[输出 occupy_map&lt;br/&gt;unordered_map&lt;VoxelIndex, VoxelGridPtr&gt;]\n        end\n\n        GEN_HEIGHT --&gt; HeightMapLine\n        GROUND_EXT --&gt; GroundExtLine\n\n        HeightMapLine --&gt; GEN_INTENSITY[GenerateIntensityCloud&lt;br/&gt;生成 intensity_cloud]\n        GroundExtLine --&gt; GEN_INTENSITY\n\n        subgraph IntensityCloud [intensity_cloud 合成]\n            direction TB\n            IC1[从occupy_map提取&lt;br/&gt;ground_cloud&lt;br/&gt;is_ground=true的体素] --&gt; IC2[筛选近地面非地面点&lt;br/&gt;30m范围内, -0.5~1.0m]\n            IC2 --&gt; IC3[合并 ground + non_ground_voi] --&gt; IC4[输出 intensity_cloud]\n        end\n\n        GEN_INTENSITY --&gt; IntensityCloud\n        IntensityCloud --&gt; GEN_2D[Generate2DImage&lt;br/&gt;生成PNG+元数据]\n\n        subgraph Gen2D [2D图像生成]\n            direction TB\n            G2D1[创建空白灰度图 CV_8UC1] --&gt; G2D2[遍历 intensity_cloud&lt;br/&gt;前ground_size个点]\n            G2D2 --&gt; G2D3[世界坐标(x,y)→像素(row,col)] --&gt; G2D4[intensity×2.55+40&lt;br/&gt;归一化到0-255]\n            G2D4 --&gt; G2D5[CLAHE对比度增强] --&gt; G2D6[保存PNG]\n            G2D6 --&gt; G2D7[写入 image_meta.txt&lt;br/&gt;min_x/min_y/width/height/...]\n        end\n\n        GEN_2D --&gt; Gen2D\n        Gen2D --&gt; GAR_END[返回 true]\n    end\n\n    CALL_GAR --&gt; GenerateAnnotationResults\n    GAR_END --&gt; PRINT_DONE[打印成功日志]\n    PRINT_DONE --&gt; END([结束])\n\n    style START fill:#90EE90\n    style END fill:#FFB6C1\n    style HM6 fill:#FFF4E6\n    style GE6 fill:#FFF4E6\n    style IC4 fill:#FFF4E6\n    style G2D6 fill:#E6FFE6\n    style G2D7 fill:#E6FFE6&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="V6AX36mM7WS2eq_MUz7W-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="2099" width="2040" as="geometry" />
          </mxCell>
        </UserObject>
