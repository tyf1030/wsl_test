        <UserObject label="load_bev_params(image_meta.txt)&lt;br&gt;读 BEV 图参数构造&amp;nbsp; image2world" mermaidId="n:E1" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="load_bev_params(image_meta.txt)&#xa;读 BEV 图参数 min_x/min_y/H/分辨率&#xa;构造 world2image → np.linalg.inv → image2world" id="I5nhy6NG0W2M_9OHj2Jm-10">
          <mxCell parent="I5nhy6NG0W2M_9OHj2Jm-6" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="76.34" width="263.2" x="457.92" y="330" as="geometry" />
          </mxCell>
