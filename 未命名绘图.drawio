  <diagram id="QjiPqfODcIWH2bisC6sC" name="外参自动标定">
    <mxGraphModel dx="3043" dy="1540" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% 入口\n    Start([bash inference_parallel.sh]) --&gt; A1{参数校验}\n    A1 --&gt;|正确| A2[case_name=basename]\n    A1 --&gt;|错误| A3[exit 1]\n    A2 --&gt; B1[mkdir output_dir]\n\n    %% 并行启动\n    B1 --&gt; C1[\&quot;GPU0: crosswalk_infer\&quot;]\n    B1 --&gt; C2[\&quot;GPU1: laneline_infer\&quot;]\n    B1 --&gt; C3[\&quot;GPU2: arrow_infer\&quot;]\n\n    %% Crosswalk\n    subgraph S1 [\&quot;Crosswalk (GPU0)\&quot;]\n        direction TB\n        C1 --&gt; D1[加载config+ckpt]\n        D1 --&gt; E1[读intensity图]\n        E1 --&gt; F1[LoadBigImagev4]\n        F1 --&gt; G1[SplitPadSampler]\n        G1 --&gt; H1[有效patch列表]\n        H1 --&gt; I1[VMA推理]\n        I1 --&gt; J1[坐标还原]\n        J1 --&gt; K1[IoU去重+多边形合并]\n        K1 --&gt; L1[crosswalks.json]\n    end\n\n    %% Laneline\n    subgraph S2 [\&quot;Laneline (GPU1)\&quot;]\n        direction TB\n        C2 --&gt; D2[加载config+ckpt]\n        D2 --&gt; E2[读intensity图]\n        E2 --&gt; F2[LoadBigImagev4]\n        F2 --&gt; G2[SplitPadSampler]\n        G2 --&gt; H2[有效patch列表]\n        H2 --&gt; I2[VMA推理]\n        I2 --&gt; J2[坐标还原]\n        J2 --&gt; K2[Chamfer去重+跨patch拼接]\n        K2 --&gt; L2[lanelines.json]\n    end\n\n    %% Arrow\n    subgraph S3 [\&quot;Arrow (GPU2)\&quot;]\n        direction TB\n        C3 --&gt; D3[YOLO推理]\n        D3 --&gt; E3[arrows.json]\n    end\n\n    %% 聚合\n    L1 &amp; L2 &amp; E3 --&gt; Wait[wait]\n    Wait --&gt; Agg[aggregate_instances.py]\n\n    subgraph S4 [\&quot;Aggregation\&quot;]\n        direction TB\n        Agg --&gt; F4[读所有JSON]\n        F4 --&gt; G4[convert_instances]\n        G4 --&gt; H4[组装标准data_dict]\n        H4 --&gt; I4[绘制可视化图]\n        I4 --&gt; J4[\&quot;{case_name}.json\&quot;]\n        I4 --&gt; K4[\&quot;{case_name}.png\&quot;]\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Hnt-usoqNLI5v3LaN7Qm-288">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Crosswalk (GPU0)" mermaidId="n:S1" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;verticalAlign=top;fillColor=light-dark(#ffffde,#1f2020);strokeColor=light-dark(#aaaa33,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Crosswalk (GPU0)" id="Hnt-usoqNLI5v3LaN7Qm-289">
          <mxCell parent="Hnt-usoqNLI5v3LaN7Qm-288" style="html=1;whiteSpace=wrap;strokeWidth=1;verticalAlign=top;fillColor=light-dark(#ffffde,#1f2020);strokeColor=light-dark(#aaaa33,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="110" width="1976" x="981" y="370" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="GPU0: crosswalk_infer" mermaidId="n:C1" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="GPU0: crosswalk_infer" id="Hnt-usoqNLI5v3LaN7Qm-290">
