  <diagram id="Y7_ZoCpXsjO5aBEosEAH" name="BEV强度图生成">
    <mxGraphModel dx="2907" dy="1320" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    START([开始]) --&gt; ARGS[解析命令行参数&lt;br/&gt;parser_path, lidar_type,&lt;br/&gt;output_path, scene_type, home]\n\n    ARGS --&gt; CHECK_SCENE{scene_type ==&lt;br/&gt;&#39;parking&#39;?}\n    CHECK_SCENE --&gt;|是| EXIT_PARKING[/打印: 跳过BEV生成&lt;br/&gt;sys.exit(0)/]\n    CHECK_SCENE --&gt;|否| CHECK_SUBDIR[调用 check_subdirs_in_parser]\n\n    subgraph check_subdirs_in_parser\n        CS1[遍历 parser_dirs 中的子目录] --&gt; CS2{子目录存在?}\n        CS2 --&gt;|否| RETURN_FALSE[返回 False]\n        CS2 --&gt;|是| CS3{cloud_reconstruction&lt;br/&gt;&amp; pose.txt 存在?}\n        CS3 --&gt;|否| RETURN_FALSE\n        CS3 --&gt;|是| CS4[继续下一个目录]\n        CS4 --&gt; CS5{所有目录检查完?}\n        CS5 --&gt;|否| CS1\n        CS5 --&gt;|是| RETURN_TRUE[返回 True]\n    end\n\n    CHECK_SUBDIR --&gt; CHECK_RESULT{检查通过?}\n    CHECK_RESULT --&gt;|否| RAISE_ERROR[/抛出 ValueError&lt;br/&gt;程序终止/]\n    CHECK_RESULT --&gt;|是| GEN_YAML[调用 generate_yaml_file]\n\n    subgraph generate_yaml_file\n        GY1[读取 rgb_yaml 模板] --&gt; GY2[读取 ground_yaml 模板]\n        GY2 --&gt; GY3[根据 parser_path 更新路径字段]\n        GY3 --&gt; GY4[将更新后的配置&lt;br/&gt;保存到 yaml_cache 目录]\n        GY4 --&gt; GY5[返回 rgb_yaml_save_path&lt;br/&gt;ground_yaml_save_path]\n    end\n\n    GEN_YAML --&gt; MKDIR{output_path&lt;br/&gt;存在?}\n    MKDIR --&gt;|否| CREATE_DIR[os.makedirs(output_path)]\n    MKDIR --&gt;|是| BUILD_CMD[构建命令]\n    CREATE_DIR --&gt; BUILD_CMD\n\n    BUILD_CMD --&gt; CMD[\n        cd {home_path} &amp;&amp;\n        ./bin/generate_intensity_point_cloud\n        {rgb_yaml} {ground_yaml}\n    ]\n\n    CMD --&gt; EXEC[os.system 执行 C++ 程序]\n\n    EXEC --&gt; PRINT_TIME[打印耗时统计]\n    PRINT_TIME --&gt; END([结束])\n\n    style START fill:#90EE90\n    style END fill:#FFB6C1\n    style EXIT_PARKING fill:#FFE4B5\n    style RAISE_ERROR fill:#FF6B6B\n    style EXEC fill:#87CEEB&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="xYfDGLgjZ11saIG-Xx07-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="check_subdirs_in_parser" mermaidId="n:check_subdirs_in_parser" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;verticalAlign=top;fillColor=light-dark(#ffffde,#1f2020);strokeColor=light-dark(#aaaa33,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="check_subdirs_in_parser" id="xYfDGLgjZ11saIG-Xx07-2">
          <mxCell parent="xYfDGLgjZ11saIG-Xx07-1" style="html=1;whiteSpace=wrap;strokeWidth=1;verticalAlign=top;fillColor=light-dark(#ffffde,#1f2020);strokeColor=light-dark(#aaaa33,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" vertex="1">
