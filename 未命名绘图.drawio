  <diagram id="8WR2F3O0ycRBRvcj6v5S" name="自动标定模块">
    <mxGraphModel dx="1456" dy="924" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    subgraph S0[\&quot;run_calib.py（编排层）\&quot;]\n        A[\&quot;python run_calib.py&lt;br/&gt;click: main(**args)\&quot;] --&gt; B[\&quot;解析参数&lt;br/&gt;local_parser / remote_parser / lidar_type&lt;br/&gt;scene_type / cluster / endpoint&lt;br/&gt;use_vma_opensrc / *_prj_dir\&quot;]\n        B --&gt; C{\&quot;scene_type == &#39;parking&#39; ?\&quot;}\n        C -- 是 --&gt; P1[\&quot;os.system(VM_CALIB_CMD)&lt;br/&gt;cd /root/vm &amp;&amp; sh run_calib.sh&lt;br/&gt;输入: {local_parser}&lt;br/&gt;输出: {local_parser}/vm_calib_cache/\&quot;]\n        C -- 否 --&gt; D{\&quot;use_vma_opensrc ?\&quot;}\n        D -- 否 --&gt; E{\&quot;remote_parser 为空 ?\&quot;}\n        E -- 是 --&gt; F[\&quot;json.load({local_parser}/data-tag.json)&lt;br/&gt;取 data_link → remote_parser&lt;br/&gt;取 aws_endpoint → endpoint / cluster&lt;br/&gt;为空则 raise ValueError\&quot;]\n        E -- 否 --&gt; G\n        F --&gt; G[\&quot;os.makedirs({local_parser}/vma_cache)\&quot;]\n        G --&gt; H[\&quot;os.system(VMA_CMD)&lt;br/&gt;cd /root/VMA &amp;&amp; sh inference_parallel.sh&lt;br/&gt;{local_parser} {local_parser}/vma_cache {endpoint}\&quot;]\n        H --&gt; I[\&quot;vma_annos_file =&lt;br/&gt;{local_parser}/vma_cache/{basename(local_parser)}.json&lt;br/&gt;conf = /root/auto-label-registration/docker/configs/petreloss.conf&lt;br/&gt;fps = 1.0(top_center_lidar) 或 2.0\&quot;]\n        D -- 是 --&gt; J[\&quot;os.system(VMA_OPEN_CMD)&lt;br/&gt;cd /root/VMA_open &amp;&amp; python -m pipeline.infer_pipeline&lt;br/&gt;输出: {local_parser}/vma_cache_opensrc/\&quot;]\n        J --&gt; K[\&quot;shutil.rmtree + makedirs({local_parser}/autocalib_cache)&lt;br/&gt;shutil.copy(vma_cache_opensrc/mask4d/mask4d.pcd → autocalib_cache/)&lt;br/&gt;vma_annos_file=&#39;None&#39;, fps=1.0, 追加 --skip-mask4d\&quot;]\n        I --&gt; L[\&quot;os.makedirs({local_parser}/autocalib_cache)\&quot;]\n        K --&gt; M\n        L --&gt; M[\&quot;os.system(ALRPY_CMD)&lt;br/&gt;python -m alrpy...run_on_hdmap&lt;br/&gt;--parse {local_parser} --vma-annos {vma_annos_file}&lt;br/&gt;--lidar-type {} --conf-path {} --cache {autocalib_cache} --fps {}\&quot;]\n    end\n\n    subgraph S1[\&quot;run_on_hdmap.py::main()（核心 pipeline，cache={local_parser}/autocalib_cache）\&quot;]\n        M --&gt; N[\&quot;组装 config 路径:&lt;br/&gt;align_file={parse}/sensor_temporal_alignment.json&lt;br/&gt;pose_file={parse}/cloud_reconstruction/pose.txt&lt;br/&gt;calib_path={parse}/calib&lt;br/&gt;bev_params={parse}/slam_output/geometry_generation_results/image_meta.txt&lt;br/&gt;ground_pcd={parse}/cloud_reconstruction/ground.pcd&lt;br/&gt;bounds=[±0.5°×3, ±1e-3m×3]\&quot;]\n        N --&gt; O{\&quot;skip_mask4d ?\&quot;}\n        O -- 否 --&gt; T1[\&quot;ThreadPoolExecutor(2) 并行\&quot;]\n        T1 --&gt; Q1[\&quot;AnnoToPCD.init → process()&lt;br/&gt;load_bev_params(image_meta.txt)&lt;br/&gt;load_vma_anno(vma_annos.json)&lt;br/&gt;process_lines/boxes(image2world)&lt;br/&gt;recover_height(ground.pcd, KDTree)&lt;br/&gt;→ lane3ds_z_from_direct_plane&lt;br/&gt;densify_* → save_annos_to_pcd&lt;br/&gt;输出: cache/mask4d.pcd\&quot;]\n        T1 --&gt; Q2[\&quot;SparseAnnoToPCD.init → process()&lt;br/&gt;同上但稀疏采样&lt;br/&gt;输出: cache/mask4d_sparse.pcd\&quot;]\n        O -- 是 --&gt; R\n        Q1 --&gt; R\n        Q2 --&gt; R\n        R[\&quot;ConcatCloudToFrames.init → process()&lt;br/&gt;load_pcd(mask4d_sparse.pcd)&lt;br/&gt;load_pose(pose.txt)&lt;br/&gt;read_calib(calib/, camera)×3&lt;br/&gt;KDTree.query_ball_point(r=200m)&lt;br/&gt;ProcessPoolExecutor:_process_one_frame&lt;br/&gt;按可见点数排序帧&lt;br/&gt;输出: cache/mask4d_sparse_to_frames.json\&quot;]\n        R --&gt; U[\&quot;ClipToDataset.init → process()&lt;br/&gt;read_extend_sensor_map:&lt;br/&gt; sense_utils.read_pose_map(pose.txt)&lt;br/&gt; sense_utils.read_sensor_map(align_file)&lt;br/&gt; merge_sensor_map_and_pose_map&lt;br/&gt; sensor_map_down_sample_with_mask4d(fps)&lt;br/&gt;sensor_map_to_dataset:&lt;br/&gt; sensor_map_to_custom_dataset(calib_path)&lt;br/&gt;save → write_json/write_jsonl&lt;br/&gt;输出: cache/sensor_map.json, cache/config.json, cache/dataset.txt\&quot;]\n        U --&gt; V[\&quot;ImageRunUndistort.init → process()&lt;br/&gt;read_jsonl(dataset.txt)&lt;br/&gt;ThreadPool: undistort()&lt;br/&gt; ├ PERSPECTIVE → shutil.copy2&lt;br/&gt; └ OPENCV_FISHEYE → cv2.fisheye.undistortImage&lt;br/&gt;   或 undistort_scaramuzza(camD 2×11)&lt;br/&gt;写: dataset.txt.undistort.bak (备份)&lt;br/&gt;覆写: dataset.txt&lt;br/&gt;图像输出: cache/undistort/\&quot;]\n        V --&gt; W{\&quot;skip_mask2former ?\&quot;}\n        W -- 否 --&gt; X[\&quot;ImageRunMask2Former.init → process()&lt;br/&gt;读 dataset.txt → inputs&lt;br/&gt;mask2former.image_run_mask2former&lt;br/&gt;(HF 缓存 facebook/mask2former-swin-large)&lt;br/&gt;输出: cache/mask2former/*.png\&quot;]\n        W -- 是 --&gt; Y\n        X --&gt; Y[\&quot;ImageRunPoseAdjustment.init → process()&lt;br/&gt;读 dataset.txt → ray.data.from_items&lt;br/&gt;map(Actor, 多GPU):&lt;br/&gt; read_point_cloud(mask4d.pcd→torch)&lt;br/&gt; read_mask_png(mask png→torch)&lt;br/&gt; loss_func_from_item → point_to_image_loss&lt;br/&gt; scipy.optimize.minimize(L-BFGS-B, bounds)&lt;br/&gt; refine_cam2cc(cam2cc, opt.x)&lt;br/&gt;输出: cache/image_pose.txt\&quot;]\n        Y --&gt; Z1[\&quot;ImagePoseToAverage.init → process()&lt;br/&gt;shutil.copytree(calib/ → cache/calib_cloud/)&lt;br/&gt;read_jsonl(image_pose.txt)&lt;br/&gt;groupby(camera_name):&lt;br/&gt; compute_cam2cc_avg_on_dataset(q分位过滤)&lt;br/&gt;  → pose_to_avg(Rotation.mean)&lt;br/&gt; update_extrinsic → 写外参+extra_info&lt;br/&gt;输出: cache/calib_cloud/{cam}/{cam}-to-car_center-extrinsic.json\&quot;]\n        Z1 --&gt; Z2[\&quot;BundleRunPoseAdjustment.init → process()&lt;br/&gt;读 image_pose.txt + calib_cloud extra_info&lt;br/&gt;filter_data_by_score(score_threshold)&lt;br/&gt;bundle_pose_adjustment(每相机):&lt;br/&gt; x0=cam2cc_avg 相对 cam2cc 的 6DoF&lt;br/&gt; func(x): ray Actor.forward 并行算&lt;br/&gt;   loss_func_from_item 平均 loss&lt;br/&gt; scipy.optimize.minimize(L-BFGS-B)&lt;br/&gt; is_angle_valid(&lt;0.2°) 校验&lt;br/&gt; refine_cam2cc → update_extrinsic&lt;br/&gt;覆写: cache/calib_cloud/{cam}/…-extrinsic.json ★最终外参\&quot;]\n    end\n\n    Z2 --&gt; FIN[\&quot;logger: Calib step finished!&lt;br/&gt;（上游 run_steps.py::step_calib 可批量循环多个 parser&lt;br/&gt;并用 upload_results 把 autocalib_cache 产物 aws s3 cp 上传）\&quot;]\n    P1 --&gt; FIN\n\n    style Z2 fill:#ffe6cc\n    style FIN fill:#d4edda&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="v40f3sM3Rfm9a50tmcP2-1">
